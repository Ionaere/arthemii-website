+  pitch += (wantPitch - pitch) * k;
+  camera.rotation.set(pitch, yaw, 0);
+}
+// any key, click, touch or wheel hands the controls back at once
+['keydown', 'pointerdown', 'wheel', 'touchstart'].forEach(ev => addEventListener(ev, () => {
