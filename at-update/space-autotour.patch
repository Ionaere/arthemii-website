+const tourDir = new THREE.Vector3();
+function tourQueue(phase) {
+  if (phase === 'videos') return items.filter(o => o.clip);
+  if (phase === 'works') return items.filter(o => !o.clip && o.state !== 'failed');
+  return items.filter(o => o.clip || o.state !== 'failed');
+}
+function startTour() {
+  if (tour || matchMedia('(prefers-reduced-motion: reduce)').matches || !items.length) return;
+  focus = null;
+  tour = { phase: 'videos', queue: tourQueue('videos'), leg: null };
+  if (!tour.queue.length) { tour.phase = 'works'; tour.queue = tourQueue('works'); }
+  vel.set(0, 0, 0);
+  const h = $('hint'); h.textContent = TOUR_TXT; h.classList.remove('is-hidden'); clearTimeout(hintTimer);
+}
+function stopTour() {
+  if (!tour) return;
+  tour = null;
+  $('hint').textContent = isTouch ? L.hintTouch : L.hint + ' · E / Q — ' + UD;
+  showHint();
+}
+function nextLeg() {
+  if (!tour.queue.length) {
+    tour.phase = tour.phase === 'videos' ? 'works' : 'all';
+    tour.queue = tourQueue(tour.phase);
+    if (!tour.queue.length) return false;
+  }
+  // the nearest work that is still waiting, so the flight never jumps around
+  let bi = 0, bd = Infinity;
+  tour.queue.forEach((o, i) => { const d = o.group.position.distanceToSquared(camera.position); if (d < bd) { bd = d; bi = i; } });
+  const o = tour.queue.splice(bi, 1)[0];
+  const p = o.group.position;
+  const half = Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2), fill = 0.6;
+  const d = Math.min(4.6, Math.max(2.6, Math.max(o.h / (fill * 2 * half), o.w / (fill * 2 * half * camera.aspect))));
+  const dir = new THREE.Vector3().subVectors(camera.position, p);
+  if (dir.lengthSq() < 1e-6) dir.set(0, 0, 1);
+  dir.normalize();
+  const to = p.clone().addScaledVector(dir, d);
+  const len = to.distanceTo(camera.position);
+  tour.leg = { o, dir, from: camera.position.clone(), to, t: 0, dur: Math.min(10, Math.max(3.5, len / 1.4)), phase: 'fly',
+               hold: 5, left: 0 };   // 5 seconds at every work before moving on
+  return true;
+}
+function tourTick(dt) {
+  if (!tour.leg && !nextLeg()) { stopTour(); return; }
+  const g = tour.leg, p = g.o.group.position;
+  if (g.phase === 'fly') {
+    g.t = Math.min(1, g.t + dt / g.dur);
+    const e = g.t < 0.5 ? 4 * g.t * g.t * g.t : 1 - Math.pow(-2 * g.t + 2, 3) / 2;
+    camera.position.lerpVectors(g.from, g.to, e);
+    if (g.t >= 1) { g.phase = 'hold'; g.left = g.hold; }
+  } else {
+    // a very slow drift towards the work while it is on screen
+    camera.position.addScaledVector(g.dir, -0.05 * dt);
+    g.left -= dt;
+    if (g.left <= 0) tour.leg = null;
+  }
+  // turn smoothly to face the work
+  const dx = p.x - camera.position.x, dy = p.y - camera.position.y, dz = p.z - camera.position.z;
